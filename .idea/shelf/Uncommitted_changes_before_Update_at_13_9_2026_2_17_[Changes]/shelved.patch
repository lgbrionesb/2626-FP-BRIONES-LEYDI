+# Reserva de un asiento en una sala de cine de 3 filas por 4 columnas.
+
+# La matriz comienza con todos los asientos libres: 0 = libre, 1 = reservado.
+asientos = [[0, 0, 0, 0] for _ in range(3)]
+
+# Se solicitan indices validos para la fila y la columna.
+while True:
+    fila = int(input("Ingrese la fila del asiento (0 a 2): "))
+    columna = int(input("Ingrese la columna del asiento (0 a 3): "))
+
+    if 0 <= fila < 3 and 0 <= columna < 4:
+        break
+
+    print("Ubicacion invalida. La fila debe estar entre 0 y 2 y la columna entre 0 y 3.")
+
+# Se marca el asiento elegido como reservado.
+asientos[fila][columna] = 1
+
+# Se muestra el estado completo de la sala usando bucles anidados.
+print("\nEstado de la sala:")
+for fila_actual in asientos:
+    for estado in fila_actual:
+        print(estado, end=" ")
+    print()
